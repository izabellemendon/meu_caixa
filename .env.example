# Copie para as "Environment Variables" do projeto no Vercel (Settings → Environment Variables).

# --- Banco (obrigatório) — criado sozinho ao adicionar o Upstash Redis em Storage no Vercel
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- IA que escreve as mensagens (opcional; sem ela, as mensagens usam um texto padrão)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# --- Segurança (recomendado)
# Só estes números podem receber mensagens (separe por vírgula). Deixe vazio para liberar qualquer número.
ALLOWED_PHONES=5592999999999
# Senha que o Vercel usa para chamar /api/cron. Invente uma sequência longa.
CRON_SECRET=
MAX_MSGS_PER_PHONE_DAY=12
MAX_MSGS_TOTAL_DAY=60

# --- WhatsApp: escolha um provedor: meta | evolution | zapi
WHATSAPP_PROVIDER=meta

# Meta (WhatsApp Cloud API oficial)
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_TEMPLATE_NAME=meu_caixa_mensagem
META_TEMPLATE_LANG=pt_BR

# Evolution API (servidor próprio)
EVOLUTION_URL=
EVOLUTION_INSTANCE=
EVOLUTION_API_KEY=

# Z-API
ZAPI_INSTANCE=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=
